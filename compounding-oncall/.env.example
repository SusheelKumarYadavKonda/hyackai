# Copy to .env and fill in. .env is gitignored -- never commit it.

# Stub flags. 1 = stub (default), 0 = call the real service.
# Each flips independently, so a slow or unavailable vendor never blocks the loop.
USE_STUB_COGNEE=1
USE_STUB_HYDRA=1
USE_STUB_HOTDATA=1
USE_STUB_ROCKETRIDE=1

# Cognee -- needs an LLM provider for cognify() extraction.
OPENAI_API_KEY=

# HydraDB -- https://app.hydradb.com
HYDRA_DB_API_KEY=
HYDRA_DATABASE=compounding_oncall
HYDRA_COLLECTION=incidents

# hotdata.dev
HOTDATA_API_KEY=
HOTDATA_WORKSPACE_ID=

# RocketRide. Must be https:// or wss:// -- http://, ws://, and bare host:port
# silently downgrade to an unencrypted connection.
ROCKETRIDE_URI=https://cloud.rocketride.ai
ROCKETRIDE_APIKEY=

# Cost model for the metrics table (approximate, blended prompt+completion).
COST_PER_1K_TOKENS=0.0045
